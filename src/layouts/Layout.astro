---
// The one layout of every page: the head of docs/design.md#head, then the container with the header,
// then the page's own blocks (the slot), placed in .column-main and .column-side (src/styles/site.css).
import monoRegular from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import sansRegular from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import sansMedium from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-500-normal.woff2?url";
import "../styles/site.css";
import Header from "../components/Header.astro";
import { colors } from "../lib/brand.ts";
import { type Index, type Project, siteName } from "../lib/content.ts";

interface Props {
  /** The Index or a Project: the page's head fields and its Address. */
  page: Pick<Index | Project, "address" | "path" | "title" | "description" | "ogImage" | "ogAlt">;
}

const { page } = Astro.props;
if (Astro.site === undefined) {
  throw new Error("astro.config.mjs sets site: the canonical URL, og:url and og:image are absolute.");
}
const url = new URL(page.path, Astro.site).href;
const ogImage = new URL(page.ogImage, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content={colors.ground}>
    <title>{page.title}</title>
    <meta name="description" content={page.description}>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="canonical" href={url}>
    <meta property="og:site_name" content={siteName}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={url}>
    <meta property="og:title" content={page.title}>
    <meta property="og:description" content={page.description}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content={page.ogAlt}>
    <meta name="twitter:card" content="summary_large_image">
    {[sansRegular, sansMedium, monoRegular].map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
  </head>
  <body>
    <div class="container">
      <Header address={page.address} path={page.path} />
      <slot />
    </div>
  </body>
</html>
