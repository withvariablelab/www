---
// A string set by the text flow of the skill's typography.md: each hyphenated term, such as type-check,
// stays whole on its line (the `term` class). The element around it sets balance or pretty.
interface Props {
  text: string;
}

const { text } = Astro.props;
// Splitting on a capturing group puts each term at an odd index.
const parts = text.split(/([\p{L}\p{N}]+(?:-[\p{L}\p{N}]+)+)/u);
---

{parts.map((part, index) => (index % 2 === 1 ? <span class="term">{part}</span> : part))}
