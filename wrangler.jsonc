{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "variablelab-www",
  "compatibility_date": "2026-10-01",
  // Assets only, no Worker script: serves what `astro build` writes to ./dist.
  // drop-trailing-slash serves dist/<project>.html at /<project> and redirects /<project>/ and /<project>.html there.
  // Never redirect /<project> to /<project>/: a Project's own Worker may send /<project>/ to /<project>, as env's does.
  // No not_found_handling, so an unknown path gets Cloudflare's own 404.
  "assets": { "directory": "./dist", "html_handling": "drop-trailing-slash" },
  // Owns the bare hostname (and creates its DNS record). A Project with its own docs claims
  // lab.variable.land/<project>/* with a more specific route; lab.variable.land/<project>,
  // its Project page, is left here (env still claims /env: see docs/design.md#external-dependency).
  "routes": [{ "pattern": "lab.variable.land", "custom_domain": true }],
  // Workers Builds runs `npx wrangler preview` on non-production branches; it fails without this block.
  "previews": {},
  // Gives each Preview a workers.dev URL; without it a Preview deployment has no URL to open.
  "preview_urls": true
}
